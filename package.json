{
  "name": "dsh-workbuddy-codex",
  "version": "0.3.3",
  "description": "DeepSeek Harness plugin that turns a local WorkBuddy gateway into a model backend for every client: registers the workbuddy model provider (mounted from dsh-llm-workbuddy), supervises the wb2api gateway, and runs both bundled protocol bridges — Responses for Codex, Anthropic Messages for Claude Code and Claude Desktop",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-workbuddy-bridge": "bin/serve.mjs"
  },
  "license": "MIT",
  "author": "kangjiazhen",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "workbuddy",
    "process-supervisor",
    "reverse-proxy",
    "codex",
    "responses-api",
    "claude",
    "claude-code",
    "claude-desktop",
    "anthropic",
    "messages-api",
    "chat-completions"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kangjiazhen/workbuddy2everything.git"
  },
  "homepage": "https://github.com/kangjiazhen/workbuddy2everything#readme",
  "bugs": {
    "url": "https://github.com/kangjiazhen/workbuddy2everything/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./supervisor": "./lib/supervisor.js",
    "./provider": "./lib/provider.js",
    "./bridge/codex-chat-bridge.mjs": "./bridge/codex-chat-bridge.mjs",
    "./bridge/anthropic-chat-bridge.mjs": "./bridge/anthropic-chat-bridge.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./status-tool": "./lib/status-tool.js"
  },
  "files": [
    "lib",
    "bin",
    "bridge",
    "cordis.patch.yml",
    "start-bridge.vbs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dependencies": {
    "dsh-llm-workbuddy": "^0.1.27"
  }
}
