{
  "name": "dsh-workbuddy-codex",
  "version": "0.3.0",
  "description": "DeepSeek Harness plugin that keeps the local WorkBuddy chain answering: registers the workbuddy model provider (mounted from dsh-llm-workbuddy), supervises the wb2api gateway, and runs the bundled Responses API bridge so Codex works too",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-workbuddy-bridge": "bin/serve.mjs"
  },
  "license": "MIT",
  "author": "kangjiazhen",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "workbuddy",
    "process-supervisor",
    "reverse-proxy",
    "codex",
    "responses-api",
    "chat-completions"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kangjiazhen/dsh-workbuddy-codex.git"
  },
  "homepage": "https://github.com/kangjiazhen/dsh-workbuddy-codex#readme",
  "bugs": {
    "url": "https://github.com/kangjiazhen/dsh-workbuddy-codex/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./supervisor": "./lib/supervisor.js",
    "./provider": "./lib/provider.js",
    "./bridge/codex-chat-bridge.mjs": "./bridge/codex-chat-bridge.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "bridge",
    "cordis.patch.yml",
    "start-bridge.vbs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
